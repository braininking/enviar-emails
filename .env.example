# Gemini AI
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL.
# Example: https://your-app.run.app
APP_URL="MY_APP_URL"

# Server-side Gmail OAuth 2.0
# Create a Web application OAuth client in Google Cloud.
# Never commit the client secret.
GMAIL_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Must exactly match one authorized redirect URI in Google Cloud.
# Example: https://your-app.run.app/api/gmail/oauth/callback
GMAIL_REDIRECT_URI="https://your-app.run.app/api/gmail/oauth/callback"

# Long random secret used to encrypt the per-browser Gmail refresh-token cookie.
# Keep this in the deployment secret manager / AI Studio Secrets.
GMAIL_SESSION_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Optional aliases kept for compatibility with deployments that already use these names:
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
